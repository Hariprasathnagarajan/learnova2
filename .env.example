# Base URL of the Learnova API, including the /api/v1 prefix.
#
# Simulator / web ......... http://localhost:8000/api/v1
# Physical device ......... http://<your-LAN-IP>:8000/api/v1   (phone must be on the same Wi-Fi)
# Deployed backend ........ https://<your-service>.onrender.com/api/v1
#
# There is no built-in fallback. The app fails fast at startup if this is unset,
# because silently pointing at a developer's machine is far harder to debug.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Publishable Razorpay key only. The key secret stays on the server and is never
# shipped in a client bundle.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME

# Logs request method/URL/status only - never headers, bodies or tokens.
# Has no effect outside a development build.
EXPO_PUBLIC_ENABLE_API_LOGGING=true