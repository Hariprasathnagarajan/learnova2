# Learnova Production Environment Configuration Example
# Copy to .env.production and fill in with your real production secrets.
#
# NOTE: these are read by the DJANGO backend, not by Expo. On Render they belong
# in the service's environment settings (or a linked secret file), never in a
# file committed to the repo. The Expo app reads a separate, non-secret set of
# EXPO_PUBLIC_* values - see .env.example.

# --- Django Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-to-a-very-long-random-string-in-production-min-50-chars
DEBUG=False
ALLOWED_HOSTS=api.learnova.app

# --- Database ---
# SQLite is development-only. Render injects DATABASE_URL for the attached Postgres.
# DATABASE_URL=postgres://learnova_user:password@host:5432/learnova_db
DB_SSL_REQUIRE=True

# --- MongoDB Database ---
# Local: mongodb://localhost:27017/learnova_db
# Cloud (Atlas): mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnova_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/learnova_db?retryWrites=true&w=majority
MONGO_DB_NAME=learnova_db

# --- CORS & CSRF ---
# Never use CORS_ALLOW_ALL_ORIGINS in production.
CORS_ALLOWED_ORIGINS=https://learnova.app,https://www.learnova.app
CSRF_TRUSTED_ORIGINS=https://learnova.app,https://api.learnova.app
SECURE_SSL_REDIRECT=True

# --- Razorpay Payment Gateway ---
# Server-side only. RAZORPAY_KEY_SECRET must never reach a client bundle and must
# never be returned by any API response - it is used to recompute the HMAC that
# settles an order.
RAZORPAY_KEY_ID=rzp_live_YourLiveKeyIdHere
RAZORPAY_KEY_SECRET=YourLiveRazorpaySecretKeyHere
# Optional: override only to point at a gateway stub in tests.
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# --- JWT Configuration ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- Protected Content ---
# Lifetime of a signed material-viewer token, in seconds.
MATERIAL_VIEWER_TTL_SECONDS=900